# Copy this file to .env and fill in real values.
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=morakinyofemii@gmail.com
PORT=3001

# Comma-separated list of frontend origins allowed to call this API in
# production, e.g. https://thyrotrack.vercel.app — leave unset in local dev.
CORS_ORIGIN=

# Where the SQLite file lives. Leave unset to use server/thyrotrack.db.
# On hosts with ephemeral local disks, point this at a mounted persistent
# volume instead (e.g. Render disks mount at /var/data).
DB_PATH=
